# Copy to .env (never committed) and fill in what you use.
# Only ANTHROPIC_API_KEY (or another LLM provider) is needed for a first run:
# speech runs locally, and web search can be switched off or replayed from fixtures.

# ----------------------------------------------------------------------------
# LLM — model-agnostic: "<provider>:<model>". Swap providers here, not in code.
#   anthropic:claude-haiku-5-5      (default: fastest, cheapest)
#   anthropic:claude-sonnet-5-5
#   openai:gpt-5-mini
#   ollama:llama3.1:8b              (open-weight, local; needs `ollama serve`)
#   google_genai:gemini-2.5-flash   (pip install ".[gemini]")
# ----------------------------------------------------------------------------
LLM_MODEL=anthropic:claude-haiku-5-5
# Optional per-agent overrides (empty = LLM_MODEL):
LLM_MODEL_ROUTER=
LLM_MODEL_PLANNER=
LLM_MODEL_RETRIEVER=
LLM_MODEL_ANSWERER=
LLM_MODEL_CRITIC=
# Hard stop for paid LLM calls, in USD (ledger: logs/llm_ledger.jsonl).
LLM_BUDGET_USD=50

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------------------
# web.search — live price / availability through one legitimate search API.
#   serper  (default; https://serper.dev, structured shopping prices)
#   tavily | brave | anthropic (Claude's web-search tool) | fixture (recorded) | none
# ----------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_FALLBACKS=
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
# Host suffixes, comma-separated. Empty allow-list = any host not on the block-list.
WEB_ALLOWED_DOMAINS=
WEB_BLOCKED_DOMAINS=pinterest.com,facebook.com,instagram.com,tiktok.com,reddit.com,quora.com

# ----------------------------------------------------------------------------
# MCP server (one server, two tools: rag.search and web.search)
# ----------------------------------------------------------------------------
# stdio | http (streamable HTTP)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
# set to use an already running HTTP server
MCP_SERVER_URL=
# web.search cache lifetime (assignment: 60-300 s)
MCP_CACHE_TTL_S=180
MCP_RATE_WEB_PER_MIN=20
MCP_RATE_RAG_PER_MIN=240

# ----------------------------------------------------------------------------
# Retrieval
# ----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# fastembed | hashing (no model files; tests and CI)
EMBEDDING_BACKEND=fastembed
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
# empty = embedded store in data/index/qdrant; or http://localhost:6333
QDRANT_URL=
QDRANT_COLLECTION=products

# ----------------------------------------------------------------------------
# Speech — local by default (no key, works offline)
# ----------------------------------------------------------------------------
# faster_whisper | openai | none
ASR_PROVIDER=faster_whisper
# tiny.en | base.en | small.en | medium.en | large-v3-turbo
ASR_MODEL=small.en
ASR_COMPUTE_TYPE=int8
# kokoro | openai | elevenlabs | none
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1.0
TTS_MAX_SECONDS=15
ELEVENLABS_API_KEY=

# ----------------------------------------------------------------------------
# Service
# ----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
